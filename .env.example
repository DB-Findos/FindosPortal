# Neon deploy writes the actual connection string to .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional direct connection for schema migrations:
DATABASE_URL_UNPOOLED=
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@findos.local
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Neon uses secure WebSockets on port 443 by default; optional override:
DB_TRANSPORT=websocket
# OpenAI key used only by the backend-side Findos KI chat.
OPENAI_API_KEY=
# Optional; defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini
# Render: NODE_ENV=production, HOST=0.0.0.0, TRUST_PROXY=1.
HOST=127.0.0.1
TRUST_PROXY=0
# Optional comma-separated browser origins for /mcp (otherwise APP_ORIGIN).
MCP_ALLOWED_ORIGINS=
